datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  firstName String
  lastName  String
  password  String
  image     String?
  isAdmin   Boolean    @default(false)
  status    StatusUser @default(ACTIVE)
  role      UserRole   @default(TREASURER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

enum StatusUser {
  ACTIVE
  INACTIVE
}

enum UserRole {
  TREASURER
  SUPER_ADMIN
  DEVELOPER
}

/**
 * ----- Entradas -----
*/

model Entries {
  id            String        @id @default(cuid())
  eventTypeId   Int
  eventType     EventType     @relation(fields: [eventTypeId], references: [id])
  eventDate     DateTime
  value         Float
  entrieType    EntrieType
  entrieChannel EntrieChannel
}

enum EntrieChannel {
  PIX
  ESPECIE
}

enum EntrieType {
  OFERTA
  DIZIMO
  GERAIS
}

model EventType {
  id      Int       @id @default(autoincrement())
  name    String    @unique
  entries Entries[]
}

/**
 * ----- Sáidas -----
 */

model Outflows {
  id          String           @id @default(cuid())
  description String
  categoryId  Int
  category    OutflowsCategory @relation(fields: [categoryId], references: [id])
  value       Float
  dateOutflow DateTime
}

model OutflowsCategory {
  id   Int    @id @default(autoincrement())
  name String @unique

  outflows Outflows[]
}
